# Backend
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/voiceagent

# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini Live
GEMINI_API_KEY=
# "pipeline": ElevenLabs Scribe -> Gemini text -> ElevenLabs speech.
# "text_pipeline": Deepgram -> Gemini text -> Gemini speech. "realtime": Gemini Live.
AGENT_ENGINE=pipeline
# Set to the deployed commit/release ID for telemetry comparisons (no spaces).
AGENT_VERSION=unknown
RECEPTIONIST_ENGINE=pipeline
LLM_MODEL=gemini-3.5-flash-lite
# Noise/voice isolation before recognition; requires LiveKit Cloud transport.
NOISE_CANCELLATION=on
# Longer pauses preserve words when callers hesitate. Tune using real recordings.
REALTIME_SILENCE_MS=700
SCRIBE_SILENCE_SECS=0.7
# ElevenLabs key with text_to_speech, speech_to_text and voices_read permissions
ELEVEN_API_KEY=
# Optional: {"default": "<voice id>", "Algenib": "<voice id>", ...} to use your own ElevenLabs voices
ELEVENLABS_VOICE_MAP=
# Optional per-language overrides; "default" applies to all otherwise unmapped voice keys.
# Use a voice tested with native Greek speech for EL, e.g. {"default":"<Greek voice id>"}.
ELEVENLABS_VOICE_MAP_EL=
ELEVENLABS_VOICE_MAP_EN=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ElevenLabs speed (0.7–1.2); Gemini speech uses delivery instructions instead.
TTS_SPEED=0.93
# Literal spoken aliases, applied to TTS only; stored names/transcripts stay original.
# Example: {"el":{"OpenAI":"Όπεν έι άι"},"en":{"Dr.":"Doctor"}}
TTS_PRONUNCIATION_ALIASES=

# Telnyx SIP trunk (210 number)
SIP_TRUNK_ID=
SIP_OUTBOUND_NUMBER=+3021XXXXXXX
# Optional: your own number, verified in Telnyx, for "call from my number"
OWN_CALLER_NUMBER=
TELNYX_PUBLIC_KEY=

# Recordings bucket (Cloudflare R2, S3-compatible)
# Recording storage: any S3-compatible bucket (on Railway, reference the bucket's variables)
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto
AWS_S3_URL_STYLE=virtual-host

# 2.0 receptionist: Google service account key (whole JSON on one line); each practice shares
# its calendar with the account's email. Empty keeps appointments only in our database.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Agent the backend dispatches web demo calls to (prank-caller-test for a local worker)
AGENT_NAME=prank-caller

# Notifications (unset channels are skipped, not queued forever)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Landing page: requests are saved and sent to this inbox once SMTP is configured.
FOUNDER_EMAIL=
# Slug of a fictional practice whose /demo/<slug> call is safe for public testing.
# Leave blank to show the personal-demo fallback instead.
LANDING_DEMO_SLUG=
# Base64-encoded 32-byte key; required before the public demo-request form accepts data.
DATA_ENCRYPTION_KEY=
# SMS through Telnyx Messaging; SMS_FROM is a Telnyx number or registered alphanumeric sender
TELNYX_API_KEY=
SMS_FROM=
# iOS push (paid Apple developer account): .p8 key contents with \n for newlines
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.alekos.prankcaller
# Call summaries and cost estimate
SUMMARY_MODEL=gemini-3.5-flash-lite
COST_MODEL_EUR_PER_MIN=0.03
COST_TELEPHONY_EUR_PER_MIN=0.01

# Agent -> backend reporting (shared secret, any long random string)
INTERNAL_API_TOKEN=
BACKEND_PUBLIC_URL=http://localhost:8000

# iOS app -> backend (paste the same value into the app's Settings tab)
APP_API_TOKEN=
# Separate founder/admin scope for practices, imports, patient data and operations.
# Must differ from APP_API_TOKEN. Required for the Receptionist tab.
ADMIN_API_TOKEN=

# Guardrails
MAX_CALL_DURATION_SECONDS=300
MAX_CONCURRENT_CALLS=1
